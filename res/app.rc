#include <winver.h>
#include "version.h"   // generated by CMake from res/version.h.in

IDI_ICON1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     KC_VER_MAJOR,KC_VER_MINOR,KC_VER_BUILD,KC_VER_REVISION
 PRODUCTVERSION  KC_VER_MAJOR,KC_VER_MINOR,KC_VER_BUILD,KC_VER_REVISION
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Keyboard Changer - per-app keyboard layout switcher"
            VALUE "FileVersion",      KC_VERSION_STR
            VALUE "InternalName",     "KeyboardChanger"
            VALUE "OriginalFilename", "KeyboardChanger.exe"
            VALUE "ProductName",      "Keyboard Changer"
            VALUE "ProductVersion",   KC_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
